{
  "name": "home-library",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "rimraf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run build && node dist/src/main",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --testMatch \"<rootDir>/*.spec.ts\" --noStackTrace --runInBand",
    "test:auth": "cross-env TEST_MODE=auth jest --testPathIgnorePatterns refresh.e2e.spec.ts --noStackTrace --runInBand",
    "test:refresh": "cross-env TEST_MODE=auth jest --testPathPattern refresh.e2e.spec.ts --noStackTrace --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "fix:deps": "rm -rf node_modules package-lock.json && npm cache clean --force && npm i",
    "docker:build": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:stop": "docker-compose stop",
    "docker:scan": "docker scout quickview dusixx/home-lib-srv-app:latest && docker scout quickview dusixx/home-lib-srv-db:latest",
    "prisma:migrate:dev:init": "npx prisma migrate dev --name init",
    "prisma:migrate:dev": "npx prisma migrate reset --force && npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:init:dev": "npm run prisma:generate && npm run prisma:migrate:dev",
    "docker:images": "docker images",
    "docker:start:db": "docker-compose up -d database",
    "docker:prune": "docker buildx prune --force",
    "docker:reset": "docker-compose down -v --rmi all --remove-orphans",
    "docker:pull": "docker pull dusixx/home-lib-srv-app:latest && docker pull dusixx/home-lib-srv-db:latest",
    "docker:network": "docker network inspect home-lib-network",
    "docker:volumes": "docker volume ls",
    "start:both": "npm run docker:reset && npm run docker:build && docker-compose watch",
    "start:app": "npm run docker:reset && docker-compose up -d database && npm run prisma:init:dev && npm run dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.16",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "http-status-codes": "^2.2.0",
    "js-yaml": "^4.1.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.2.8",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "cpy-cli": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "prisma": "^7.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "buffer-equal-constant-time": "1.0.1"
  }
}
